{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build:css": "tailwindcss -i ./resources/css/app.css -o ./public/css/app.css --minify",
        "watch:css": "tailwindcss -i ./resources/css/app.css -o ./public/css/app.css --watch",
        "build:js": "esbuild resources/js/app.js --bundle --outfile=public/js/app.js --minify",
        "watch:js": "esbuild resources/js/app.js --bundle --outfile=public/js/app.js --watch",
        "build": "npm run build:css && npm run build:js",
        "watch": "npm run watch:css & npm run watch:js",
        "dev": "npm run watch:css"
    },
    "devDependencies": {
        "auto-prefixer": "^0.4.2",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.18",
        "vite": "^7.0.7"
    }
}
